{
  "name": "openbutler-desktop",
  "version": "0.1.9",
  "private": true,
  "description": "OpenButler Windows desktop shell",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:frontend": "node scripts/build-frontend-for-desktop.mjs",
    "build:backend": "pyinstaller --noconfirm desktop_backend.spec",
    "pack": "npm run build:frontend && electron-builder --dir",
    "pack:nightly": "node scripts/build-nightly-unpacked.mjs",
    "check:nightly": "node --test scripts/check-nightly-unpacked.test.mjs",
    "dist": "node scripts/build-installer.mjs",
    "dist:preview": "node scripts/build-preview-installer.mjs",
    "dist:release": "node scripts/build-stable-release.mjs",
    "check:offline-ocr": "node scripts/copy-offline-ocr-assets.cjs && node scripts/check-offline-ocr.cjs",
    "predev": "node scripts/copy-offline-ocr-assets.cjs",
    "prepack": "node scripts/copy-offline-ocr-assets.cjs",
    "predist": "node scripts/copy-offline-ocr-assets.cjs",
    "predist:release": "node scripts/copy-offline-ocr-assets.cjs",
    "check": "node scripts/check-desktop-contract.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs",
    "smoke:preview-packaged": "node scripts/smoke-packaged-app.mjs --channel=preview",
    "check:frontend-assets": "node scripts/check-desktop-frontend-assets.mjs",
    "smoke:installer-lifecycle": "node scripts/smoke-installer-lifecycle.mjs",
    "smoke:preview-installer-lifecycle": "node scripts/smoke-installer-lifecycle.mjs --channel=preview"
  },
  "build": {
    "appId": "moe.giftia.openbutler",
    "productName": "OpenButler",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "src/*.ps1"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": ".tmp/ocr-languages",
        "to": "ocr-languages"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "dist/openbutler-backend.exe",
        "to": "backend/openbutler-backend.exe"
      }
    ],
    "win": {
      "icon": "assets/openbutler.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "OpenButler-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "installer/installer.nsh",
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@expo-google-fonts/roboto": "0.4.3",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "pureimage": "0.4.20"
  },
  "dependencies": {
    "pngjs": "7.0.0",
    "tesseract.js": "6.0.1"
  }
}
